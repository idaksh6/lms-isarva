APP_NAME="ISARVA LMS (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://lmsdev.isarva.in

# Demo logins on sign-in page — OK for staging/demo server only
LMS_SHOW_DEMO_CREDENTIALS=true

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lmsdev_db
DB_USERNAME=lmsdev_user
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@isarva.in"
MAIL_FROM_NAME="${APP_NAME}"
